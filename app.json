{
  "expo": {
    "name": "코트큐",
    "slug": "badminton-court-manager",
    "version": "1.0.0",
    "orientation": "default",
    "platforms": [
      "android",
      "ios"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "코트큐 방 QR 코드를 스캔하기 위해 카메라를 사용합니다.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "android": {
      "package": "com.kubc.baidmintoncourt",
      "versionCode": 24,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#006B45"
      }
    },
    "ios": {
      "bundleIdentifier": "com.kubc.baidmintoncourt",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "extra": {
      "eas": {
        "projectId": "2f8252c1-0bd6-4604-a1eb-739a481f979c"
      }
    }
  }
}
